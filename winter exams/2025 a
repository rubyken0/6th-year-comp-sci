#iii adding more conditions
def get_grade(result):
    grade = "Unsuccessful"
     
    if result >= 80:
        grade = "Distinction"
    elif result >= 65:
        grade = "Upper Merit"
    elif result >=50:
        grade="Lower Merit"
    elif result >=40:
        grade="Pass"
    
    return grade 
 
# Calculate and display the mean of a list of results 
results = [39,32,62,88,51,62,64,81,77] # Initialise the list 
N = len(results) # Initialise N to the number of results 
total = 0 # Initialise the running total to 0 
  
# Loop N times 
for i in range(N):
    total = total + results[i] # Running total 
 
# Divide by the total number of results to give the mean #i rounding to 2 decimal places using round function #ii replacing nine with N
arithmetic_mean=round(total/N,2)
# Display the answer 
print("The mean percentage mark is", arithmetic_mean)

#iv making grade the function with the mean passed through and printing grade
grade=get_grade(arithmetic_mean)
print(f"The grade for the average result is {grade}")

#v finding highest and lowest score using max and min functions
print(f"\nThe lowest score is {min(results)}")
print(f"The highest score is {max(results)}")

